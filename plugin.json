{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-token-usage",
  "version": "0.2.0",
  "description": "Read local Codex prompt token usage and recorded 5-hour and 7-day limit percentages.",
  "author": {
    "name": "jaemanc"
  },
  "homepage": "https://github.com/jaemanc/codex-token-usage",
  "repository": "https://github.com/jaemanc/codex-token-usage",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Codex Token Usage",
        "shortDescription": "Local prompt usage report",
        "longDescription": "Read local Codex session logs to report prompt and response times, token counts, and recorded 5-hour and 7-day usage-limit percentages. Runs on your desktop with Python 3; no plugin server or account connection is required.",
        "developerName": "jaemanc",
        "category": "Developer Tools",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://github.com/jaemanc/codex-token-usage",
        "supportURL": "https://github.com/jaemanc/codex-token-usage/blob/main/SUPPORT.md",
        "privacyPolicyURL": "https://github.com/jaemanc/codex-token-usage/blob/main/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/jaemanc/codex-token-usage/blob/main/TERMS.md",
        "defaultPrompt": [
          "Show my latest Codex prompt token usage and 5-hour and 7-day limit changes."
        ],
        "brandColor": "#12355B",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg"
      }
    }
  }
}
